{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "custom/logo",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/metrics",
    "group/io",
    "tray"
  ],
  "group/metrics": {
    "orientation": "inherit",
    "modules": [
      "custom/icon-cpu",
      "cpu",
      "custom/icon-temp",
      "temperature",
      "custom/icon-gpu",
      "custom/gpu",
      "custom/icon-mem",
      "memory",
      "custom/icon-disk",
      "disk"
    ]
  },
  "custom/logo": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": false,
    "persistent-workspaces": {
      "*": 6
    }
  },
  "clock": {
    "format": "<span color='#6b6b6b'>{0:%a %d %b}</span>   {0:%H:%M}",
    "format-alt": "{:%A %d %B %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "today": "<b>{}</b>"
      }
    }
  },
  "cpu": {
    "format": "{usage}%",
    "interval": 2
  },
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
    "critical-threshold": 85,
    "format": "{temperatureC}°",
    "format-critical": "{temperatureC}°",
    "interval": 3
  },
  "custom/gpu": {
    "exec": "/home/m1ke/.config/waybar/scripts/gpu.sh",
    "return-type": "json",
    "interval": 3
  },
  "memory": {
    "format": "{percentage}%",
    "interval": 3,
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },
  "disk": {
    "path": "/",
    "format": "{percentage_used}%",
    "interval": 30,
    "tooltip-format": "{used} / {total} en /"
  },
  "network": {
    "format-wifi": "{bandwidthDownBytes}",
    "format-ethernet": "{bandwidthDownBytes}",
    "format-disconnected": "off",
    "interval": 2,
    "tooltip-format": "{ifname} {ipaddr}  ↓{bandwidthDownBytes}  ↑{bandwidthUpBytes}"
  },
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "mute",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": false
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "states": { "warning": 25, "critical": 12 },
    "interval": 30,
    "tooltip-format": "{timeTo} · {power}W"
  },
  "tray": {
    "spacing": 10
  },
  "custom/icon-cpu": {
    "format": " ",
    "tooltip": false
  },
  "custom/icon-temp": {
    "format": " ",
    "tooltip": false
  },
  "custom/icon-gpu": {
    "format": " ",
    "tooltip": false
  },
  "custom/icon-mem": {
    "format": " ",
    "tooltip": false
  },
  "custom/icon-disk": {
    "format": " ",
    "tooltip": false
  },
  "group/io": {
    "orientation": "inherit",
    "modules": [
      "backlight",
      "battery",
      "custom/icon-vol",
      "pulseaudio",
      "custom/icon-net",
      "network"
    ]
  },
  "custom/icon-vol": {
    "format": " ",
    "tooltip": false
  },
  "custom/icon-net": {
    "format": " ",
    "tooltip": false
  }
}
