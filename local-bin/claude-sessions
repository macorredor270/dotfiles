#!/usr/bin/env python3
# Lista las sesiones de Claude Code (más recientes primero): id \t cwd \t texto visible
import glob, json, os, datetime
rows = []
for f in glob.glob(os.path.expanduser('~/.claude/projects/*/*.jsonl')):
    cwd = title = None
    try:
        with open(f, encoding='utf-8') as fh:
            for line in fh:
                try: d = json.loads(line)
                except ValueError: continue
                if cwd is None and d.get('cwd'): cwd = d['cwd']
                if title is None and d.get('type') == 'user' and not d.get('isSidechain') and not d.get('isMeta'):
                    c = d.get('message', {}).get('content')
                    if isinstance(c, list):
                        c = next((x.get('text') for x in c if isinstance(x, dict) and x.get('type') == 'text'), None)
                    if isinstance(c, str):
                        c = ' '.join(c.split())
                        if c and not c.startswith('<'):
                            title = c
                if cwd and title: break
    except OSError:
        continue
    if cwd and title:
        rows.append((os.path.getmtime(f), os.path.basename(f)[:-6], cwd, title))
for m, sid, cwd, title in sorted(rows, reverse=True)[:300]:
    home = os.path.expanduser('~')
    short = '~' + cwd[len(home):] if cwd.startswith(home) else cwd
    date = datetime.datetime.fromtimestamp(m).strftime('%d %b %H:%M')
    print(f"{sid}\t{cwd}\t{date}  {short}  │  {title[:100]}")
